  "difficulty": {
    "class_sep": 1.5,
    "label_noise": 0.02
  },
  "constraints": {
    "memory_limit_mb": 6,
    "max_train_time_sec": 600
  },
  "data": {
    "path": null,
    "target_column": "label"
  }
